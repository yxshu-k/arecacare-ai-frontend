{
  "expo": {
    "name": "ArecaCare AI",
    "slug": "arecacare-ai-frontend",
    "scheme": "arecacare",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.yakshitha.arecacareaifrontend"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "98094460-70f6-4cd7-bcb3-8bde7d5cf546"
      }
    }
  }
}