# EXPO Environment Variables
# 
# To connect to your local FastAPI backend running on your computer,
# you MUST change localhost to your computer's actual local IP address (e.g., 192.168.x.x)
# because the Android Emulator / iOS device runs on its own isolated network.
# 
# Once deployed to production, change this to your actual HTTPS server URL.

EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
